# X Layer mainnet (chain 196). The router accepts several URLs separated by commas and falls back in order.
XLAYER_RPC_URL=https://rpc.xlayer.tech

# Wallets: keep keys in Foundry's encrypted keystore (`cast wallet import`), not in this file.
# Only the account names and public addresses live here.
DEPLOYER_ACCOUNT=policyrouter-deployer
DEPLOYER_ADDRESS=
ROUTER_ACCOUNT=policyrouter-router
ROUTER_ADDRESS=

# Router service only: the router signs receipts and calls settle() with this key.
# Load it from a secret manager in production.
ROUTER_PRIVATE_KEY=

# Router service (router/): see docs/router.md
PORT=8787
# relative to router/
DATABASE_PATH=policyrouter.sqlite
RATE_LIMIT_PER_MINUTE=60
# How long a block number is reused before re-reading chain state (ms). Lower = kill switch bites sooner.
BLOCK_CACHE_MS=1000
RPC_TIMEOUT_MS=5000
# Live OKB/USD price (OKX → CoinGecko → CoinPaprika): refresh interval, and how old a price may be before
# charged requests are refused with 503 price_unavailable
PRICE_REFRESH_MS=60000
# Sources in order of preference (okx, coingecko, coinpaprika). Leave out any your network blocks.
PRICE_SOURCES=okx,coingecko,coinpaprika
PRICE_MAX_AGE_MS=600000
# Where verify-receipt fetches receipts from
ROUTER_URL=http://localhost:8787
# Settle receipts on chain every N ms (0 = off; run `pnpm --filter @policyrouter/router settle` instead)
SETTLE_INTERVAL_MS=300000

# Model catalog (models, providers, prices). Default: router/catalog.json
# CATALOG_PATH=

# AI providers (server side only, never sent to clients). Each provider's key is read from the
# variable its catalog entry names in apiKeyEnv.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Deployed contracts (see deployments/xlayer.json). Phase 1:
TREASURY_ADDRESS=0xad56De63a2F9F5f1170E9044046C15ee467b6288
PROCESSOR_ADDRESS=0x11FF9976c86E4C868a803Bc9B5E1ba7749226f99
TRANSISTORS_ADDRESS=0x8B37B74083Eb87A5B725B152621c729b478262E9
# Phase 2:
POLICY_REGISTRY_ADDRESS=0x7F05d6c389F973EA3Fb10A3Eb27e338f8eB42D0a
CREDIT_ESCROW_ADDRESS=0xCc2dd59C8042e42253D1C14d5c34F976226b7F7A
