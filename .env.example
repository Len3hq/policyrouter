# X Layer mainnet (chain 196)
XLAYER_RPC_URL=https://rpc.xlayer.tech

# Wallets: keep keys in Foundry's encrypted keystore (`cast wallet import`), not in this file.
# Only the account names and public addresses live here.
DEPLOYER_ACCOUNT=policyrouter-deployer
DEPLOYER_ADDRESS=
ROUTER_ACCOUNT=policyrouter-router
ROUTER_ADDRESS=

# Router service only: the router signs receipts and calls settle() with this key.
# Load it from a secret manager in production.
ROUTER_PRIVATE_KEY=

# AI providers (server side only, never sent to clients)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Deployed contracts (see deployments/xlayer.json). Phase 1:
TREASURY_ADDRESS=0xad56De63a2F9F5f1170E9044046C15ee467b6288
PROCESSOR_ADDRESS=0x11FF9976c86E4C868a803Bc9B5E1ba7749226f99
TRANSISTORS_ADDRESS=0x8B37B74083Eb87A5B725B152621c729b478262E9
