{
  "name": "policyrouter",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:contracts": "cd contracts && forge test",
    "test:fork": "cd contracts && forge test --match-path 'test/fork/*' --fork-url ${XLAYER_RPC_URL:-https://rpc.xlayer.tech}"
  }
}
